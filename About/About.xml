<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
    <name>Neutroflow</name>
    <author>Sk</author>
    <packageId>sk.neutroflow</packageId>
    <supportedVersions>
        <li>1.6</li>
    </supportedVersions>
    <description>Makes the neutroamine pipe network from Vanilla Races Expanded - Android actually matter. Biosculpter pods, growth vats, mech gestators, the gene extractor, and cryptosleep caskets each draw a standby rate from that network while idle and a higher rate while actively working; if the network runs dry, the device's operation pauses (or, for an occupied cryptosleep casket, ejects its occupant) instead of silently continuing for free.</description>
    <modVersion>1.0.1</modVersion>
    <url>https://steamcommunity.com/sharedfiles/filedetails/?id=3807468351</url>
    <modDependencies>
        <li>
            <packageId>brrainz.harmony</packageId>
            <displayName>Harmony</displayName>
            <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
            <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
        </li>
        <li>
            <packageId>vanillaracesexpanded.android</packageId>
            <displayName>Vanilla Races Expanded - Android</displayName>
            <steamWorkshopUrl>steam://url/CommunityFilePage/2975771801</steamWorkshopUrl>
            <downloadUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=2975771801</downloadUrl>
        </li>
        <li>
            <packageId>ludeon.rimworld.biotech</packageId>
            <displayName>Biotech</displayName>
        </li>
    </modDependencies>
    <loadAfter>
        <li>Mlie.BioReactor</li>
    </loadAfter>
</ModMetaData>
