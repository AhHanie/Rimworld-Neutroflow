<?xml version="1.0" encoding="UTF-8"?>
<Patch>

  <!-- BioReactor (2x2) -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="BioReactor"]</xpath>
    <value>
      <modExtensions>
        <li Class="Neutroflow.NeutroamineUsageExtension">
          <idlePerDay>0.10</idlePerDay>
          <activePerDay>1.0</activePerDay>
          <activityMode>BioReactorOccupied</activityMode>
          <starvationMode>Eject</starvationMode>
        </li>
      </modExtensions>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="BioReactor"]/comps</xpath>
    <value>
      <li Class="Neutroflow.CompProperties_NeutroamineConsumer">
        <pipeNet>VREA_NeutroamineNet</pipeNet>
      </li>
    </value>
  </Operation>

