          <activityMode>MechGestationForming</activityMode>
          <starvationMode>Pause</starvationMode>
        </li>
      </modExtensions>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="LargeMechGestator"]/comps</xpath>
